# Server Port (Auto-assigned by Render)
PORT=5005

# Node Environment
NODE_ENV=production

# Database (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/chronobite?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=chronobite_jwt_super_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Settings
CORS_ORIGIN=*

# Payment Gateway (Razorpay Sandbox/Live)
RAZORPAY_KEY_ID=rzp_test_chronobite123
RAZORPAY_KEY_SECRET=chronobite_razorpay_secret_key_123
RAZORPAY_WEBHOOK_SECRET=chronobite_razorpay_webhook_secret_123
